struct CPhysicsActor: CActor {
    f32 mass = mMass
    f32 inertiaTensor = mInertiaTensor
    bool movable = mMovable
    bool angularEnabled = mAngularEnabled
    bool standardCollider = mStandardCollider
    CVector3f constantForce = mConstantForce
    CVector3f angularMomentum = mAngularMomentum
    CVector3f velocity = mVelocity
    CVector3f momentum = mMomentum
    CVector3f force = mForce
    CVector3f impulse = mImpulse
    CVector3f torque = mTorque
    CVector3f angularImpulse = mAngularImpulse
    CAABB baseBoundingBox = mBaseBoundingBox
    CAABBPrimitive collisionPrimitive = mCollisionPrimitive
    CVector3f primitiveOffset = mPrimitiveOffset
    CMotionState lastNonCollidingState = mLastNonCollidingState
    CQuaternion orientation = mLastNonCollidingState.mOrientation
    CVector3f lastFloorPlaneNormal = mLastFloorPlaneNormal.m_data
    f32 maxCollisionVelocity = mMaximumCollisionVelocity
    f32 stepUpHeight = mStepUpHeight
    f32 stepDownHeight = mStepDownHeight
}