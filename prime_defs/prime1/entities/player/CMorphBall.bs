struct CMorphBall {
    CCollidableSphere collisionSphere = mCollisionSphere
    // TODO: this may be handy later   CCollisionInfoList x74_collisionInfos;\

    ESpiderBallState spiderBallState = mSpiderBallState

    f32 ballTiltAngle = mBallTiltAngle
    bool tireMode = mTireMode
    f32 tireLeanAngle = mTireLeanAngle
    CTransform surfaceToWorld = mSurfaceToWorld
    f32 tireFactor = mTireFactor
    f32 maxTireFactor = mMaxTireFactor
    f32 tireInterpSpeed = mTireInterpSpeed
    bool tireInterpolating = mTireInterpolating
    f32 boostOverLightFactor = mBoostOverLightFactor
    f32 boostLightFactor = mBoostLightFactor
    f32 spiderLightFactor = mSpiderLightFactor

    EBallBoostState boostState = mBoostState
    CVector3f boostControlForce = mBoostControlForce
    CVector3f controlForce = mControlForce
    bool inBoost = mInBoost
    bool boostEnabled = mBoostEnabled
    f32 boostChargeTime = mBoostChargeTime
    f32 timeNotInBoost = mTimeNotInBoost
    f32 boostDrainTime = mBoostDrainTime

    bool inHalfPipeMode = mInHalfPipeMode
    bool inHalfPipeModeInAir = mInHalfPipeModeInAir
    bool touchedHalfPipeRecently = mTouchedHalfPipeRecently
    bool ballCloseToCollision = mBallCloseToCollision
    f32 touchHalfPipeCooldown = mTouchHalfPipeCooldown
    f32 disableControlCooldown = mDisableControlCooldown
    f32 touchHalfPipeRecentCooldown = mTouchHalfPipeRecentCooldown
    CVector3f prevHalfPipeNormal = mPrevHalfPipeNormal
    CVector3f halfPipeNormal = mHalfPipeNormal

    EBombJumpState bombJumpState = mBombJumpState

    // decomp: TReservedAverage<CVector3f, 15> — inline rstl::reserved_vector storage
    // (count word followed by 15 CVector3f slots), not a pointer-based container.
    u32 liftControlForceAvgCount = mLiftControlForceAvg.mCount
    CVector3f[15] liftControlForceAvg = mLiftControlForceAvg.mData
    u32 liftSpeedAvgCount = mLiftSpeedAvg.mCount
    f32 liftSpeedAvg = mLiftSpeedAvg.mData
}

enum EBallBoostState: u32 { BoostAvailable, BoostDisabled }

enum ESpiderBallState: u32 { Inactive, Active }

enum EBombJumpState: u32 { BombJumpAvailable, BombJumpDisabled }