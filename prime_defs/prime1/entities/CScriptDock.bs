struct CScriptDock: CPhysicsActor {

    i32 dockReferenceCount = mDockReferenceCount
    i32 dock = mDock
    u32 area = mArea
    EDockState dockState = mDockState
    bool dockReferenced = mDockReferenced
    bool loadConnected = mLoadConnected
    bool areaPostConstructed = mAreaPostConstructed
}

enum EDockState: u32 {
    Idle,
    PlayerTouched,
    EnterNextArea,
    Three
}