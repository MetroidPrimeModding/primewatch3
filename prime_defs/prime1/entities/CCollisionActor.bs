struct CCollisionActor: CPhysicsActor {
  vtable 0x803e4b18

  *CCollidableOBBTreeGroupContainer obbContainer 0x278
  *CCollidableOBBTreeGroup obbTreeGroupPrimitive 0x27c
  *CCollidableAABox aabbPrimitive 0x280
  *CCollidableSphere spherePrimitive 0x284
  }

struct CCollisionPrimitive {
  vtable 0x803d97e4

  *u8 info 0x4
}

struct CCollidableSphere: CCollisionPrimitive {
  vtable 0x803ecaf8

  CSphere sphere 0x10
}

struct CCollidableAABox: CCollisionPrimitive {
  vtable 0x803ecad0

  CAABB aabb 0x10
}

struct CCollidableOBBTreeGroup: CCollisionPrimitive {
  vtable 0x803ec470

  *CCollidableOBBTreeGroupContainer container 0x10
}

struct CCollidableOBBTreeGroupContainer {
    rstl::vector<rstl::autoptr<COBBTree>> trees 0x4
    rstl::vector<CAABB> aabbs 0x14
    CAABB aabb 0x20
}

struct COBBTree {
  u32 magic 0x0
  u32 version 0x4
  u32 memsize 0x8
  SIndexData indexData 0x18
  *CNode root 0x88
}

// decomp `COBBTree::SIndexData` (0x70): seven `rstl::vector`s at 0x0, 0x10 …
// 0x60. `rstl::vector` here points its member offset at `count` (allocator + 4),
// so each offset below is the decomp field offset + 4.
struct SIndexData {
  rstl::vector<u32> materials 0x4
  rstl::vector<u8> vertMaterials 0x14
  rstl::vector<u8> edgeMaterials 0x24
  rstl::vector<u8> surfaceMaterials 0x34
  rstl::vector<CCollisionEdge> edges 0x44
  rstl::vector<u16> surfaceIndices 0x54
  rstl::vector<CVector3f> vertices 0x64
}
