struct CCollisionActor: CPhysicsActor {

  *CCollidableOBBTreeGroupContainer obbContainer = mObbContainer
  *CCollidableOBBTreeGroup obbTreeGroupPrimitive = mObbTreeGroupPrimitive
  *CCollidableAABox aabbPrimitive = mAaboxPrimitive
  *CCollidableSphere spherePrimitive = mSpherePrimitive
  }

struct CCollisionPrimitive {

  u64 material = mMaterial
}

struct CCollidableSphere: CCollisionPrimitive {

  CSphere sphere = mSphere
}

struct CCollidableAABox: CCollisionPrimitive {

  CAABB aabb = mAabb
}

struct CCollidableOBBTreeGroup: CCollisionPrimitive {

  *CCollidableOBBTreeGroupContainer container = mContainer
}

struct CCollidableOBBTreeGroupContainer {
    rstl::vector<rstl::autoptr<COBBTree>> trees = mTrees.mCount
    rstl::vector<CAABB> aabbs = mAabbs.mCount
    CAABB aabb = mAabox
}

struct COBBTree {
  u32 magic = mMagic
  u32 version = mVersion
  u32 memsize = mMemsize
  SIndexData indexData = mIndexData
  *CNode root = mRoot
}

// decomp `COBBTree::SIndexData` (0x70): seven `rstl::vector`s at 0x0, 0x10 …
// 0x60. `rstl::vector` here points its member offset at `count` (allocator + 4),
// so each offset below is the decomp field offset + 4.
struct SIndexData {
  rstl::vector<u32> materials = mMaterials.mCount
  rstl::vector<u8> vertMaterials = mVertMaterials.mCount
  rstl::vector<u8> edgeMaterials = mEdgeMaterials.mCount
  rstl::vector<u8> surfaceMaterials = mSurfaceMaterials.mCount
  rstl::vector<CCollisionEdge> edges = mEdges.mCount
  rstl::vector<u16> surfaceIndices = mSurfaceIndices.mCount
  rstl::vector<CVector3f> vertices = mVertices.mCount
}
