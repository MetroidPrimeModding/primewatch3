struct CSphere {
    CVector3f origin = mCenter
    f32 radius = mRadius
}

// Inlined `CCollidableSphere`: `CCollisionPrimitive` base (vtable 0x0,
// `x8_material` at 0x8) plus the local `CSphere` at 0x10. Mirror of
// `CAABBPrimitive` for the sphere subclasses of `CPhysicsActor`.
struct CSpherePrimitive {
    decomp CCollidableSphere
    u64 material = mMaterial
    CSphere sphere = mSphere
}
