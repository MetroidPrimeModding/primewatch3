struct CWorldState {
    u32 assetId = mWorldId
    u32 areaId = mAreaId
    rstl::rc_ptr<CScriptLayerState> layerManager = mLayerState
}

struct CScriptLayerState {
    rstl::vector2<CWorldLayers::Area> areas 0x0
}

struct CWorldLayers::Area {
    u32 startNameIdx 0x0
    u32 layerCount 0x4
    u32 layerBitsLo 0x8
    u32 layerBitsHi 0xC
}